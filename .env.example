# Copy to `.env.local` and restart `npm run dev`.

# Цена Elite на странице профиля (текст для пользователя)
NEXT_PUBLIC_ELITE_PRICE_LABEL=299 ₽ / мес

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Тестовый флаг Elite без Stripe (кнопки на профиле «Есть подписка / Без подписки»)
ELITE_DEV_TOGGLE=true
NEXT_PUBLIC_ELITE_DEV_TOGGLE=true

# Stripe — для настоящей оплаты «Купить Elite»
STRIPE_SECRET_KEY=
STRIPE_ELITE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Firebase Admin (обязательно для тестового флага и webhook)
# FIREBASE_SERVICE_ACCOUNT_JSON_FILE=firebase-admin-key.json
